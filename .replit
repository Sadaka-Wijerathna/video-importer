run = "python main.py"
entrypoint = "main.py"
modules = ["python-3.12"]

[nix]
channel = "stable-24_11"

[nix.packages]
ffmpeg = "ffmpeg"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "pip install -r requirements.txt"]
run = ["python", "main.py"]

[[ports]]
localPort = 8080
externalPort = 80
